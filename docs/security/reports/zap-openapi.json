        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chainId": {
                    "type": "integer"
                  }
                }
              },
              "example": {
                "chainId": 31337
              }
            }
          }
        }
      }
    },
    "/api/runs/RUN_ID": {
      "get": {
        "summary": "run",
