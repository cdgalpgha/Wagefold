            "description": "ok"
          }
        }
      }
    },
    "/api/runs/RUN_ID/approve": {
      "get": {
        "summary": "approval message",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "post": {
        "summary": "approve",
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "signature": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "signature": "0x00"
              }
            }
          }
        }
      }
    },
    "/api/runs/RUN_ID/reject": {
      "post": {
        "summary": "reject",
