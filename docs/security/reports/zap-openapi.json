              },
              "example": {
                "reason": "test"
              }
            }
          }
        }
      }
    },
    "/api/runs/RUN_ID/cancel": {
      "post": {
        "summary": "cancel",
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              },
              "example": {}
            }
          }
        }
      }
    },
    "/api/runs/RUN_ID/request": {
      "post": {
        "summary": "request",
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "signature": {
                    "type": "string",
                    "example": "0xababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababab"
                  }
                }
              },
              "example": {
                "verifiedWallets": []
              }
            }
          }
        }
      },
      "get": {
        "summary": "The message the preparer signs",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/api/runs/RUN_ID/submit": {
      "post": {
        "summary": "submit",
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "txHash": {
                    "type": "string"
                  },
                  "safeTxHash": {
                    "type": "string"
                  },
                  "verifiedWallets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "examples": {
                "sent": {
                  "value": {
                    "txHash": "0xabababababababababababababababababababababababababababababababab"
                  }
                },
                "safe": {
                  "value": {
                    "safeTxHash": "0x5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/RUN_ID/confirm": {
      "post": {
        "summary": "confirm",
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              },
              "example": {}
            }
          }
        }
      }
    },
    "/api/records": {
      "get": {
        "summary": "records",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "2026"
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/api/invoices": {
      "get": {
        "summary": "invoices",
