# Required in production: long random string used to sign session cookies.
SESSION_SECRET=

# Optional. Leave empty to use the embedded Postgres (PGlite) stored in ./.data/pglite.
# Set to a postgres:// URL for hosted Postgres in production.
DATABASE_URL=

# The public address of the app, e.g. https://wagefold.app. Wallets show it when connecting; it must
# match the page. Optional: without it the page's own address is used.
NEXT_PUBLIC_APP_URL=

# WalletConnect Cloud project id (enables Trust Wallet and other mobile wallets via QR code).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed WagefoldPayroll contract per chain. A chain only appears in the app once this is set.
NEXT_PUBLIC_PAYROLL_ADDRESS_8453=
NEXT_PUBLIC_PAYROLL_ADDRESS_84532=
NEXT_PUBLIC_PAYROLL_ADDRESS_31337=

# Token overrides. Base and Base Sepolia USDC have defaults; set USDT on Base after verifying it.
NEXT_PUBLIC_USDT_ADDRESS_8453=
NEXT_PUBLIC_USDT_ADDRESS_84532=
NEXT_PUBLIC_USDC_ADDRESS_31337=
NEXT_PUBLIC_USDT_ADDRESS_31337=

# Browser RPC endpoints (optional). Without them the browser uses Base's public, rate-limited endpoints;
# with them it tries your provider first and falls back to the public one. Visible to every visitor:
# use a provider key restricted to your domain, separate from the server keys below.
NEXT_PUBLIC_RPC_URL_8453=
NEXT_PUBLIC_RPC_URL_84532=

# Server-side RPC endpoints used to verify sign-ins and payroll transactions.
RPC_URL_8453=https://mainnet.base.org
RPC_URL_84532=https://sepolia.base.org
RPC_URL_31337=http://127.0.0.1:8545

# Required in production: the exact host users sign in on, e.g. wagefold.app (no https://).
APP_DOMAIN=

# Optional: record a market USD rate in exports and payslips instead of par (1 token = 1 USD).
# Chainlink-style aggregator per token and chain. Verify the address on data.chain.link first.
PRICE_FEED_USDC_8453=
PRICE_FEED_USDT_8453=

# Behind a proxy that sets X-Forwarded-For itself (Vercel, Cloudflare, a load balancer): set to 1 so
# sign-in is rate-limited per client IP. Leave unset otherwise; the header can't be trusted then.
TRUST_PROXY=
