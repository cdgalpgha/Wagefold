# Required in production: long random string used to sign session cookies.
SESSION_SECRET=

# Optional. Leave empty to use the embedded Postgres (PGlite) stored in ./.data/pglite.
# Set to a postgres:// URL for hosted Postgres in production.
DATABASE_URL=

# WalletConnect Cloud project id (enables Trust Wallet and other mobile wallets via QR code).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed WagefoldPayroll contract per chain. A chain only appears in the app once this is set.
NEXT_PUBLIC_PAYROLL_ADDRESS_8453=
NEXT_PUBLIC_PAYROLL_ADDRESS_84532=
NEXT_PUBLIC_PAYROLL_ADDRESS_31337=

# Token overrides. Base and Base Sepolia USDC have defaults; set USDT on Base after verifying it.
NEXT_PUBLIC_USDT_ADDRESS_8453=
NEXT_PUBLIC_USDT_ADDRESS_84532=
NEXT_PUBLIC_USDC_ADDRESS_31337=
NEXT_PUBLIC_USDT_ADDRESS_31337=

# Server-side RPC endpoints used to verify sign-ins and payroll transactions.
RPC_URL_8453=https://mainnet.base.org
RPC_URL_84532=https://sepolia.base.org
RPC_URL_31337=http://127.0.0.1:8545
